#!/usr/bin/env bash
# boot/install — put the Liquid boot chain in place, from the firmware's logo to the desktop and
# back. Needs root, and knows who you are from sudo:
#
#   sudo ~/dotfiles/boot/install          all of it; safe to run again
#   sudo ~/dotfiles/boot/install theme    only re-render the splash: after a new wallpaper or palette
#   sudo ~/dotfiles/boot/install undo     back to the text login on tty1 and no splash
#
# What it changes, keeping each file as it was the first time as FILE.liquid-orig:
#   /usr/share/plymouth/themes/liquid/         the splash, rendered as you by boot/plymouth/render
#   /etc/plymouth/plymouthd.conf               Theme=liquid; DeviceScale=1, as it's drawn in pixels
#   /etc/mkinitcpio.conf                       the plymouth hook after udev, then mkinitcpio -P
#   /boot/loader/entries/*.conf, the linux one quiet splash loglevel=3 rd.udev.log_level=3
#                                              vt.global_cursor_default=0 (fallback left alone)
#   /etc/systemd/system/plymouth-quit.service.d/liquid.conf   the fade to black before the greeter
#   /etc/greetd/config.toml                    the Liquid greeter (boot/greeter/start), and greetd
#                                              enabled in place of the login on tty1
# greetd isn't started now: it takes tty1, and the session running there with it. It's up from the
# next boot. If it ever won't come up, Ctrl+Alt+F2 still gives a text login to run `undo` from.
set -euo pipefail

here=$(dirname "$(readlink -f "$0")")
repo=$(dirname "$here")
theme_dir=/usr/share/plymouth/themes/liquid
params=(quiet splash loglevel=3 rd.udev.log_level=3 vt.global_cursor_default=0)

say() { printf '\033[1;33m::\033[0m %s\n' "$*"; }
die() { printf 'install: %s\n' "$*" >&2; exit 1; }

[ "$(id -u)" = 0 ] || die "needs root: sudo $0 ${1:-}"
user=${SUDO_USER:-}
[ -n "$user" ] && [ "$user" != root ] || die "run it with sudo from your own account, so it knows whose shell to use"
home=$(getent passwd "$user" | cut -d: -f6)
case "$here" in
    */.claude/worktrees/*) die "run it from the main checkout ($home/dotfiles), not a worktree: greetd keeps the path" ;;
esac

backup() { [ -e "$1.liquid-orig" ] || cp -a "$1" "$1.liquid-orig"; }

linux_entries() {
    local e
    for e in /boot/loader/entries/*.conf; do
        grep -Eq '^initrd[[:space:]]+/initramfs-linux\.img[[:space:]]*$' "$e" && printf '%s\n' "$e"
    done
}

theme() {
    say "rendering the splash from your wallpaper"
    local tmp
    tmp=$(mktemp -d)
    chown "$user" "$tmp"
    sudo -u "$user" -H "$here/plymouth/render" "$tmp/liquid" --dest "$theme_dir"
    install -d -m755 "$theme_dir"
    rm -f "$theme_dir"/*
    install -m644 "$tmp/liquid"/* "$theme_dir"/
    rm -rf "$tmp"
}

plymouth_conf() {
    backup /etc/plymouth/plymouthd.conf
    cat > /etc/plymouth/plymouthd.conf <<'EOF'
# Written by boot/install in the dotfiles; what was here is plymouthd.conf.liquid-orig.
# The Liquid theme is drawn in the panel's own pixels, so Plymouth mustn't scale it up for HiDPI.
[Daemon]
Theme=liquid
DeviceScale=1
EOF
}

hook() {
    local conf=/etc/mkinitcpio.conf
    if grep -Eq '^HOOKS=\(.*[( ]plymouth[ )]' "$conf"; then return; fi
    [ -z "$(ls -A /etc/mkinitcpio.conf.d 2>/dev/null)" ] || die "/etc/mkinitcpio.conf.d has files that may set HOOKS; add plymouth after udev there by hand"
    grep -Eq '^HOOKS=\(.*[( ]udev[ )]' "$conf" || die "HOOKS in $conf has no udev to put plymouth after"
    say "adding the plymouth hook to $conf"
    backup "$conf"
    sed -i -E '/^HOOKS=\(/ s/([( ])udev([ )])/\1udev plymouth\2/' "$conf"
}

unhook() {
    sed -i -E '/^HOOKS=\(/ s/ plymouth([ )])/\1/' /etc/mkinitcpio.conf
}

cmdline() {
    local e
    while read -r e; do
        backup "$e"
        awk -v add="${params[*]}" '
            /^options[ \t]/ {
                n = split(add, a, " ")
                for (i = 1; i <= n; i++) if (index(" " $0 " ", " " a[i] " ") == 0) $0 = $0 " " a[i]
                gsub(/[ \t]+/, " ")
            }
            { print }' "$e" > "$e.new"
        mv "$e.new" "$e"
        say "kernel line in $e: $(sed -n 's/^options[[:space:]]*//p' "$e")"
    done < <(linux_entries)
}

uncmdline() {
    local e
    while read -r e; do
        awk -v drop="${params[*]}" '
            /^options[ \t]/ {
                n = split(drop, d, " "); for (i = 1; i <= n; i++) gone[d[i]] = 1
                m = split($0, w, /[ \t]+/); line = w[1]
                for (i = 2; i <= m; i++) if (w[i] != "" && !(w[i] in gone)) line = line " " w[i]
                $0 = line
            }
            { print }' "$e" > "$e.new"
        mv "$e.new" "$e"
    done < <(linux_entries)
}

greeter() {
    say "setting greetd up with the Liquid greeter"
    [ -f "$home/.config/quickshell/liquid/greeter.qml" ] \
        || sudo -u "$user" -H stow -d "$repo" -t "$home" --no-folding quickshell
    [ -f "$home/.config/quickshell/liquid/greeter.qml" ] || die "no $home/.config/quickshell/liquid/greeter.qml; stow quickshell first"
    backup /etc/greetd/config.toml
    cat > /etc/greetd/config.toml <<EOF
# Written by boot/install in the dotfiles: the Liquid greeter, run as the greeter user from
# $here/greeter. What was here is config.toml.liquid-orig;
# \`sudo $here/install undo\` puts it back.
[terminal]
vt = 1

[default_session]
command = "env LIQUID_USER=$user LIQUID_HOME=$home $here/greeter/start"
user = "greeter"
EOF
    install -D -m644 "$here/systemd/plymouth-quit.service.d/liquid.conf" /etc/systemd/system/plymouth-quit.service.d/liquid.conf
    systemctl daemon-reload
    systemctl enable greetd.service
}

case "${1:-all}" in
    all)
        say "installing plymouth and greetd"
        pacman -S --needed --noconfirm plymouth greetd
        theme
        plymouth_conf
        hook
        cmdline
        greeter
        say "rebuilding the initramfs"
        mkinitcpio -P
        say "done. It all starts with the next boot; until then nothing you're running has changed."
        ;;
    theme)
        theme
        say "rebuilding the initramfs, which carries the splash"
        mkinitcpio -P
        ;;
    undo)
        say "back to the text login and no splash"
        systemctl disable greetd.service || true
        [ -e /etc/greetd/config.toml.liquid-orig ] && cp -a /etc/greetd/config.toml.liquid-orig /etc/greetd/config.toml
        rm -rf /etc/systemd/system/plymouth-quit.service.d/liquid.conf
        rmdir /etc/systemd/system/plymouth-quit.service.d 2>/dev/null || true
        [ -e /etc/plymouth/plymouthd.conf.liquid-orig ] && cp -a /etc/plymouth/plymouthd.conf.liquid-orig /etc/plymouth/plymouthd.conf
        unhook
        uncmdline
        systemctl daemon-reload
        mkinitcpio -P
        say "done; the splash's files stay in $theme_dir and plymouth stays installed"
        ;;
    *)
        die "usage: sudo $0 [all|theme|undo]"
        ;;
esac
