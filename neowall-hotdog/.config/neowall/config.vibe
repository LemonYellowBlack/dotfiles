# hotdog's wallpaper: a solid sumiInk0 (#16161D). The orbit3d shader and
# the night train are kept below, commented out; for the night train, what
# each line is for and how to test it is in
# ~/.config/neowall/shaders/nighttrain/nighttrain.vibe.
default {
  path ~/Pictures/Wallpapers/solid-sumiInk0.png
  mode stretch
  # orbit3d:
  #shader orbit3d.glsl
  #shader_speed 1.0
  #vsync true
  #shader_fps 30
  # night train:
  #terminal "env -u SSH_AUTH_SOCK python3 ~/.config/neowall/shaders/nighttrain/nighttrain.py"
  #term_shader ~/.config/neowall/shaders/nighttrain/nighttrain.glsl
  #term_font /usr/share/fonts/noto/NotoSansMono-Medium.ttf
  #term_font_size 48
  #term_cols 0
  #term_rows 0
  #vsync true
  #shader_fps 30
}
