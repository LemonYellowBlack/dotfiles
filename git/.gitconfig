[user]
	email = rwszymczak@proton.me
	name = lemonyellowblack
[pull]
	rebase = true
	ff = only
[rebase]
	autoStash = true
[core]
	hooksPath = ~/.config/git/hooks
	pager = delta
	editor = nvim
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	light = false
	line-numbers = true
	syntax-theme = theme
[merge]
	conflictstyle = zdiff3
[init]
	defaultBranch = main
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
# delta's colors, from this machine's theme (theme/retheme writes them).
[include]
	path = ~/.config/theme/delta.gitconfig
