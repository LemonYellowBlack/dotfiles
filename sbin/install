#!/usr/bin/env bash
# sbin/install — put the helpers sudo runs without a password where only root can change them.
#
#   sudo ~/dotfiles/sbin/install
#
# gpu-on, gpu-off and platform-profile run as root with no password: the shell's GPU and profile
# toggles and the game wrapper call them. Their sudoers rules used to name the copies stowed in
# ~/.local/bin, which are symlinks into this repo, so anything running as you could rewrite one and
# be root. This installs root-owned copies in /usr/local/sbin and moves the rules there. A change
# made here then reaches root only through running this again.
#
# It rewrites only rules that already name one of the old paths; a machine without them gets none.
# Each sudoers file it touches is checked with visudo first, swapped in by rename, and kept as it
# was in FILE.pre-sbin (sudo skips files with a dot in their name in /etc/sudoers.d).
set -euo pipefail

here=$(dirname "$(readlink -f "$0")")
dest=/usr/local/sbin
helpers=(gpu-on gpu-off platform-profile)

say() { printf '\033[1;33m::\033[0m %s\n' "$*"; }
die() { printf 'install: %s\n' "$*" >&2; exit 1; }

[ "$(id -u)" = 0 ] || die "needs root: sudo $0"
user=${SUDO_USER:-}
[ -n "$user" ] && [ "$user" != root ] || die "run it with sudo from your own account, so it knows whose rules to move"
home=$(getent passwd "$user" | cut -d: -f6)

install -d -o root -g root -m 755 "$dest"
for h in "${helpers[@]}"; do
    install -o root -g root -m 755 "$here/$h" "$dest/$h"
done
say "installed ${helpers[*]} in $dest, owned by root"

old="${home//./\\.}/\\.local/bin/(gpu-on|gpu-off|platform-profile)([^[:alnum:]_-]|\$)"
files=()
for f in /etc/sudoers /etc/sudoers.d/*; do
    if [ -f "$f" ] && grep -Eq "$old" "$f"; then files+=("$f"); fi
done

restore() {
    local f
    for f in "${files[@]}"; do
        if [ -e "$f.pre-sbin" ]; then cp -a "$f.pre-sbin" "$f"; fi
    done
}

for f in "${files[@]}"; do
    tmp=$(mktemp "$(dirname "$f")/.sbin-XXXXXX")
    sed -E "s#$old#$dest/\\1\\2#g" "$f" > "$tmp"
    chown root:root "$tmp"
    chmod 0440 "$tmp"
    if ! visudo -cqf "$tmp"; then
        rm -f "$tmp"
        die "$f wouldn't parse with the new paths, so it's as it was"
    fi
    [ -e "$f.pre-sbin" ] || cp -a "$f" "$f.pre-sbin"
    mv -f "$tmp" "$f"
    say "rules in $f now name $dest"
done

if ! visudo -cq; then
    restore
    die "sudo's config as a whole wouldn't parse; put the old files back"
fi

if [ ${#files[@]} -eq 0 ]; then
    if grep -Eqs "$dest/(gpu-on|gpu-off|platform-profile)" /etc/sudoers /etc/sudoers.d/*; then
        say "the rules already name $dest"
    else
        say "no sudoers rule names these helpers; add one with visudo if they should run without a password"
    fi
fi

say "what $user may run without a password now:"
sudo -l -U "$user" | grep -i nopasswd || true
