default {
  shader jelly.glsl
  shader_speed 1.0
  # vsync on: frames are paced to the 60 Hz panel, so motion is smooth.
  # (off, neowall paces with its own timer, which drifts against the panel.)
  vsync true
  # With vsync on, neowall ignores this for pacing and uses it only as the
  # budget for its automatic resolution scaling. A lenient budget means it
  # never resizes orbit3d's simulation buffer, and a resize would wipe it.
  shader_fps 30
}
