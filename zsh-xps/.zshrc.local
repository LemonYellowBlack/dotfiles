# .zshrc.local — Dell XPS (laptop)
# Sourced at the end of zsh/.zshrc. Hybrid-graphics specific.

# Run a command on the dGPU via PRIME offload
alias prime='__NV_PRIME_RENDER_OFFLOAD=1 __GLX_VENDOR_LIBRARY_NAME=nvidia'

# disable/enable nvidia drivers, without typing sudo: root's own copies (sbin/ in the dotfiles)
gpu-off() { sudo /usr/local/sbin/gpu-off "$@"; }
gpu-on()  { sudo /usr/local/sbin/gpu-on  "$@"; }
