#!/usr/bin/env bash
# zen/link — point Zen's default profile at the dotfiles. Zen's profile folder has a random name
# that differs per machine, so it can't be a Stow package; this finds it instead.
#
#   ~/dotfiles/zen/link          link it all; safe to run again
#   ~/dotfiles/zen/link undo     remove the links and put back what was there
#
# In the profile (the one installs.ini says this Zen opens, else profiles.ini's Default=1):
#   user.js                 → zen/user.js
#   chrome/userChrome.css   → ~/.config/theme/zen/userChrome.css   (rendered by retheme)
#   chrome/userContent.css  → ~/.config/theme/zen/userContent.css  (rendered by retheme)
# Only these three: the rest of the profile (cookies, history, logins, prefs.js, and the
# zen-themes.css Zen Mods writes) stays out of the repo. A file already there is kept as
# FILE.dotfiles-orig. Zen reads them only at startup, so restart it after.
set -euo pipefail

here=$(dirname "$(readlink -f "$0")")
zen=$HOME/.config/zen
theme=$HOME/.config/theme/zen

say() { printf '\033[1;33m::\033[0m %s\n' "$*"; }
die() { printf 'zen/link: %s\n' "$*" >&2; exit 1; }

find_profile() {
	local p=""
	[ -f "$zen/installs.ini" ] && p=$(sed -n 's/^Default=//p' "$zen/installs.ini" | head -n1)
	if [ -z "$p" ] && [ -f "$zen/profiles.ini" ]; then
		p=$(awk -F= '/^\[/ { if (d && p != "") { print p; exit } p = ""; d = 0 }
		             /^Path=/ { p = substr($0, 6) } /^Default=1$/ { d = 1 }
		             END { if (d && p != "") print p }' "$zen/profiles.ini" | head -n1)
	fi
	[ -n "$p" ] || die "no default profile in $zen/installs.ini or profiles.ini; start Zen once first"
	case $p in /*) ;; *) p=$zen/$p ;; esac
	[ -d "$p" ] || die "the default profile, $p, isn't there"
	printf '%s\n' "$p"
}

link() {  # link TARGET LINK
	local target=$1 at=$2
	if [ -L "$at" ] && [ "$(readlink "$at")" = "$target" ]; then
		return
	fi
	if [ -e "$at" ] || [ -L "$at" ]; then
		[ -e "$at.dotfiles-orig" ] || [ -L "$at.dotfiles-orig" ] &&
			die "${at/#$HOME/\~} is in the way and ${at/#$HOME/\~}.dotfiles-orig already exists; move one"
		mv "$at" "$at.dotfiles-orig"
		say "kept the old ${at##*/} as ${at##*/}.dotfiles-orig"
	fi
	mkdir -p "$(dirname "$at")"
	ln -s "$target" "$at"
	say "linked ${at/#$HOME/\~}"
}

unlink_one() {  # unlink TARGET LINK
	local target=$1 at=$2
	if [ -L "$at" ] && [ "$(readlink "$at")" = "$target" ]; then
		rm "$at"
		say "removed ${at/#$HOME/\~}"
		if [ -e "$at.dotfiles-orig" ] || [ -L "$at.dotfiles-orig" ]; then
			mv "$at.dotfiles-orig" "$at"
			say "put back the old ${at##*/}"
		fi
	fi
}

profile=$(find_profile)
pairs=(
	"$here/user.js" "$profile/user.js"
	"$theme/userChrome.css" "$profile/chrome/userChrome.css"
	"$theme/userContent.css" "$profile/chrome/userContent.css"
)

case ${1:-} in
	"")
		[ -f "$theme/userChrome.css" ] && [ -f "$theme/userContent.css" ] ||
			die "no theme for Zen in ${theme/#$HOME/\~} yet; run retheme first"
		for ((i = 0; i < ${#pairs[@]}; i += 2)); do link "${pairs[i]}" "${pairs[i + 1]}"; done
		;;
	undo)
		for ((i = 0; i < ${#pairs[@]}; i += 2)); do unlink_one "${pairs[i]}" "${pairs[i + 1]}"; done
		;;
	*) die "usage: $0 [undo]" ;;
esac
pgrep -x zen-bin >/dev/null && say "restart Zen to pick it up" || true
