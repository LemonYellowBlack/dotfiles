# {{waveAqua2}} → teal    (hostname, matches starship)
# {{oniViolet}} → purple  (directory, matches starship)
# {{autumnGreen}} → green   (git branch, autumnGreen — "git add" in the palette)
# {{carpYellow}} → yellow  (model name)
# {{textFaint}} → muted   (context usage)
# {{hot}} → orange  (session name / high context warning)
teal='\033[38;2;{{waveAqua2|sgr}}m'
purple='\033[38;2;{{oniViolet|sgr}}m'
green='\033[38;2;{{autumnGreen|sgr}}m'
yellow='\033[38;2;{{carpYellow|sgr}}m'
muted='\033[38;2;{{textFaint|sgr}}m'
orange='\033[38;2;{{hot|sgr}}m'
