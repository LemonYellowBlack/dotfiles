-- PROMPT1: user@host colored {{secondary|ref}}, db in {{accentSoft|ref}}, then a
-- {{accent|ref}} chevron. %x shows *-marked transaction state in {{danger|ref}}.
\set PROMPT1 '%[%033[38;2;{{secondary|sgr}}m%]%n@%m%[%033[0m%] %[%033[38;2;{{accentSoft|sgr}}m%]%/%[%033[0m%]%[%033[38;2;{{danger|sgr}}m%]%x%[%033[0m%]\n%[%033[38;2;{{accent|sgr}}m%]❯%[%033[0m%] '
-- PROMPT2 (continuation) — muted {{textFaint|ref}} marker.
\set PROMPT2 '%[%033[38;2;{{textFaint|sgr}}m%]%/%R%#%[%033[0m%] '
-- PROMPT3 (COPY prompt).
\set PROMPT3 '%[%033[38;2;{{textFaint|sgr}}m%]»%[%033[0m%] '
