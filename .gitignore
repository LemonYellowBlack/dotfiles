scripts/wallpapers/
ssh/.ssh/config
bin/.local/bin/claude
bin/.local/bin/moshi*

# herdr writes runtime state beside its config; belt-and-braces if the
# package is ever stowed without --no-folding (see README gotcha).
herdr/.config/herdr/*.log
herdr/.config/herdr/*.sock
herdr/.config/herdr/session.json
herdr/.config/herdr/.plugins.lock

# neowall writes a runtime state file beside its config; same reasoning.
neowall/.config/neowall/state

.claude/settings.local.json
.claude/worktrees/

# theme/retheme writes these for one machine's palette (theme/hosts/<host>.toml), so they're never
# shared. They land here because ~/.config/bat, yazi and television are stowed as whole folders;
# everything else it writes lives outside the dotfiles, in ~/.config/theme/ and the like.
bat/.config/bat/themes/theme.tmTheme
yazi/.config/yazi/flavors/theme.yazi/
television/.config/television/themes/theme.toml
